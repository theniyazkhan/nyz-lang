dekha "=== Sylheti-Lang Calculator ===";

dekha "Enter first number (a):";
dhoro a;
ne a;

dekha "Enter second number (b):";
dhoro b;
ne b;

dekha "--- Calculation Results ---";

dhoro sum = a + b;
dekha "a + b =";
dekha sum;

dhoro diff = a - b;
dekha "a - b =";
dekha diff;

dhoro prod = a * b;
dekha "a * b =";
dekha prod;

jodi (b != 0) {
  dhoro quot = a / b;
  dekha "a / b =";
  dekha quot;
} naile {
  dekha "a / b = Division by zero avoided!";
}

dhoro pwr = a ^ b;
dekha "a ^ b =";
dekha pwr;

dekha "=== Finished ===";
