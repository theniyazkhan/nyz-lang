dekha "=== Sylheti Language Keywords & Operators Test ===";

dhoro a = 10;
dhoro b = 20;

jodi (a < b ar hasa) {
  dekha "a is smaller than b!";
} naile {
  dekha "a is greater or equal!";
}

jodi (nabe (a == b)) {
  dekha "a and b are NOT equal (hasa)!";
}

dekha "--- Ghuro Loop (While) ---";
dhoro count = 3;
ghuro (count > 0) {
  dekha count;
  count = count - 1;
}

dekha "--- Ghur Loop (For) ---";
ghur (dhoro i = 1; i <= 3; i = i + 1) {
  dekha i;
}

dekha "=== Keywords Test Passed ===";
