dekha "=== Sylheti Exponentiation (Power ^) Test ===";

dhoro base = 2;
dhoro exp = 3;
dhoro result = base ^ exp;

dekha "2 ^ 3 =";
dekha result;

dhoro pow_assoc = 2 ^ 3 ^ 2;
dekha "2 ^ 3 ^ 2 (Right-Associative) =";
dekha pow_assoc;

dhoro expr_power = 3 + 2 ^ 3 * 4;
dekha "3 + 2 ^ 3 * 4 (Precedence) =";
dekha expr_power;
