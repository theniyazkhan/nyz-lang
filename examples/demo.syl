dekha "=== Sylheti-ang Demonstration ===";

dhoro a = 5;
dhoro b = 3;
dhoro pow = a ^ b;

dekha "Calculated 5 ^ 3:";
dekha pow;

jodi (pow > 100 ar hasa) {
  dekha "Result is greater than 100!";
} naile {
  dekha "Result is smaller!";
}

dekha "--- Ghur (For Loop) Countdown ---";
ghur (dhoro i = 5; i > 0; i = i - 1) {
  dekha "Count:";
  dekha i;
}

dekha "=== Sylheti Demo Finished ===";
